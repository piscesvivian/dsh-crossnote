{
  "name": "@local/dsh-crossnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: merge multiple Markdown files into one via crossnote/MPE @import, with heading demotion and section renaming.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "src/*.js",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
